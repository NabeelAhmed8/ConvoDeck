MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/convodeck?retryWrites=true&w=majority

NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

WHATSAPP_PHONE_NUMBER_ID=your_meta_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=your_meta_business_account_id
WHATSAPP_ACCESS_TOKEN=your_meta_system_user_access_token
WHATSAPP_WEBHOOK_VERIFY_TOKEN=convodeck_secure_token

DEFAULT_WORKSPACE_ID=convodeck_default_workspace

SESSION_SECRET=create_a_random_32_character_secret_key_here

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM=noreply@convodeck.com
